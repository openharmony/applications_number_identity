import("//build/ohos.gni")
ohos_shared_library("caller_info_query_extension") {
  include_dirs = [
        "core/include",
        "napi_helper/include"
  ]

  sources = [
    "./core/src/caller_info_query_extension_context.cpp",
    "./core/src/caller_info_query_extension.cpp",
    "./core/src/caller_info_query_stub_impl.cpp",
    "./core/src/caller_info_query_stub.cpp",
    "./core/src/js_caller_info_query_extension_context.cpp",
    "./core/src/js_caller_info_query_extension.cpp",
    "./core/src/caller_Info_query_extension_callback_data.cpp",
    "./napi_helper/src/call_napi_async_callback_data.cpp",
    "./napi_helper/src/call_napi_async_data.cpp",
    "./napi_helper/src/call_napi_invoker_helper.cpp",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:abilitykit_native",
    "ability_runtime:napi_common",
    "ability_runtime:ability_context_native",
    "ability_runtime:app_context",
    "ability_runtime:extensionkit_native",
    "ability_runtime:runtime",
    "access_token:libaccesstoken_sdk",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "hilog:libhilog",
    "ipc:ipc_core",
    "ipc:ipc_napi",
    "napi:ace_napi",
  ]

  sanitize = {
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
    integer_overflow = true
    ubsan = true
  }

  branch_protector_ret = "pac_ret"
  subsystem_name = "telephony"
  part_name = "number_identity"
}

ohos_shared_library("caller_info_query_extension_module") {
    include_dirs = [
      "core/include"
    ]

  sources = [ "./core/src/caller_info_query_extension_module_loader.cpp" ]

  configs = [
    "//build/config/gcc:symbol_visibility_hidden",
  ]
  deps = [ ":caller_info_query_extension" ]

  external_deps = [
    "ability_runtime:napi_common",
    "ability_runtime:abilitykit_native",
    "hilog:libhilog",
    "napi:ace_napi",
    "ipc:ipc_core",
    "ipc:ipc_napi",
  ]

  relative_install_dir = "extensionability/"
  sanitize = {
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
    integer_overflow = true
    ubsan = true
  }

  branch_protector_ret = "pac_ret"
  subsystem_name = "telephony"
  part_name = "number_identity"
}
