import("//build/ohos.gni")

## Install numberlocation.dat to /system/etc/telephony/numberlocation.dat

## Do not forget to update JSON property `component.build.group_type.service_group` in number_identity/bundle.json.

ohos_prebuilt_etc("number_location_default") {
  source = "numberlocation.dat"
  relative_install_dir = "./telephony"
  part_name = "number_identity"
  subsystem_name = "telephony"
}

ohos_prebuilt_etc("yellow_page_default") {
  source = "yellowpage.data"
  relative_install_dir = "./telephony"
  part_name = "number_identity"
  subsystem_name = "telephony"
}

ohos_prebuilt_etc("number_location_data_default") {
  source = "numberlocation.data"
  relative_install_dir = "./telephony"
  part_name = "number_identity"
  subsystem_name = "telephony"
}

ohos_prebuilt_etc("number_identity_config_default") {
  source = "number_identity_config.json"
  relative_install_dir = "./telephony"
  part_name = "number_identity"
  subsystem_name = "telephony"
}

group("number_location") {
  deps = [
  #  ":number_location_default",
    ":yellow_page_default",
  #  ":number_identity_config_default",
    ":number_location_data_default",
  ]
}